
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /user_profiles/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid;
    }

    match /tables/{tableId} {
      match /notes/{noteId} {
        function isTableMember() {
          return request.auth != null
            && request.auth.uid in get(
              /databases/$(database)/documents/tables/$(tableId)
            ).data.memberIds;
        }
        // Members can view all notes
        allow read: if isTableMember();
        // Members can create notes under their own UID
        allow create: if isTableMember()
          && request.resource.data.createdBy == request.auth.uid;
        // Members can edit notes, but not change their creator
        allow update: if isTableMember()
          && request.resource.data.createdBy == resource.data.createdBy;
        // Members can delete notes
        allow delete: if isTableMember();
      }

      allow list: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      allow update: if request.auth != null
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['memberIds'])
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size()
            == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.size() <= 50
        && request.resource.data.memberIds.hasAll(
            resource.data.memberIds
        )
        && request.auth.uid in request.resource.data.memberIds;

      allow delete: if false;
            










            
    }
  }
}
