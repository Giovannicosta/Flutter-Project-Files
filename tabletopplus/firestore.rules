rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /user_profiles/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid;
    }

    match /tables/{tableId} {
      function signedIn() {
        return request.auth != null;
      }

      function member() {
        return signedIn() && request.auth.uid in resource.data.memberIds;
      }

      function owner() {
        return signedIn() && request.auth.uid == resource.data.ownerId;
      }

      function listIsValid() {
        return request.resource.data.memberIds is list
          && request.resource.data.get('moderatorIds', []) is list
          && request.resource.data.get('bannedIds', []) is list
          && request.resource.data.memberIds.size() <= 50
          && request.resource.data.get('bannedIds', []).size() <= 100
          && request.resource.data.ownerId in request.resource.data.memberIds
          && request.resource.data.get('moderatorIds', [])
              .hasOnly(request.resource.data.memberIds)
          && !request.resource.data.memberIds
              .hasAny(request.resource.data.get('bannedIds', []))
          && !(request.resource.data.ownerId in request.resource.data.get('bannedIds', []));
      }

      // Invite code is an unpredictable table document ID; permit direct lookups.
      // List queries remain restricted to tables the user is a member of.
      allow get: if signedIn();
      allow list: if member();

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.get('moderatorIds', []) == []
        && request.resource.data.get('bannedIds', []) == []
        && request.resource.data.memberNames is map
        && request.resource.data.memberNames.keys().hasOnly([request.auth.uid])
        && request.resource.data.memberNames[request.auth.uid] is string
        && request.resource.data.memberNames[request.auth.uid].size() <= 60
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.createdAt == request.time;

      // Joining: only append your own UID and public display name.
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && !(request.auth.uid in resource.data.get('bannedIds', []))
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberIds', 'memberNames'])
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberNames is map
        && request.resource.data.memberNames.diff(resource.data.get('memberNames', {}))
            .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.memberNames[request.auth.uid] is string
        && request.resource.data.memberNames[request.auth.uid].size() <= 60
        && listIsValid();

      // Members may update only their own public name in this table.
      // This also populates legacy tables that have no memberNames map.
      allow update: if member()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberNames'])
        && request.resource.data.memberNames is map
        && request.resource.data.memberNames.diff(resource.data.get('memberNames', {}))
            .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.memberNames[request.auth.uid] is string
        && request.resource.data.memberNames[request.auth.uid].size() > 0
        && request.resource.data.memberNames[request.auth.uid].size() <= 60;

      // Owner may only change membership, moderator assignments and bans.
      allow update: if owner()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberIds', 'moderatorIds', 'bannedIds'])
        && listIsValid();

      // A moderator may kick one regular member, without banning anyone,
      // changing privileges, or removing the owner / another moderator.
      allow update: if member()
        && request.auth.uid in resource.data.get('moderatorIds', [])
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberIds'])
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
        && resource.data.memberIds.hasAll(request.resource.data.memberIds)
        && request.resource.data.memberIds.hasAll(resource.data.get('moderatorIds', []))
        && resource.data.ownerId in request.resource.data.memberIds
        && listIsValid();

      allow delete: if false;

      match /achievements/{achievementId} {
        function tableMember() {
          return request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/tables/$(tableId)).data.memberIds;
        }

        allow read: if tableMember();
        allow create: if tableMember()
          && request.resource.data.keys().hasOnly(['title', 'body', 'createdBy', 'createdAt'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 80
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 2000;
      }

      match /notes/{noteId} {
        function tableDoc() {
          return get(/databases/$(database)/documents/tables/$(tableId)).data;
        }
        function tableMember() {
          return request.auth != null
            && request.auth.uid in tableDoc().memberIds;
        }
        function privileged() {
          return request.auth.uid == tableDoc().ownerId
            || request.auth.uid in tableDoc().get('moderatorIds', []);
        }

        allow read: if tableMember();
        allow create: if tableMember()
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if tableMember()
          && request.resource.data.createdBy == resource.data.createdBy
          && (resource.data.createdBy == request.auth.uid || privileged());
        // All members can edit shared notes; only the creator or a moderator
        // or owner may delete one.
        allow delete: if tableMember()
          && (resource.data.createdBy == request.auth.uid || privileged());
      }
    }
  }
}
